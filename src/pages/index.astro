---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Product from "../components/Product.astro";
import Promotions from "../components/Promotions.astro";
import BrandStory from "../components/BrandStory.astro";
import Delivery from "../components/Delivery.astro";
import Gallery from "../components/Gallery.astro";
import Instagram from "../components/Instagram.astro";
import OrderDrawer from "../components/OrderDrawer.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <Product />
    <Promotions />
    <BrandStory />
    <Delivery />
    <Gallery />
    <Instagram />
  </main>
  <Footer />
  <OrderDrawer />
</MainLayout>

<script>
  fetch("/api/auth/logout", { method: "POST", keepalive: true }).catch(() => {});
</script>

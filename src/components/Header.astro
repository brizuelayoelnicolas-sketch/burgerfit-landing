---
import { burgerfit } from "../data/burgerfit";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <a class="brand-lockup" href="#inicio" aria-label="Burgerfit, ir al inicio">
      <img
        class="brand-lockup__image"
        src={burgerfit.images.mascot}
        alt=""
        width="56"
        height="56"
      />
      <span class="brand-lockup__name">Burger<span>fit</span></span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Abrir menú de navegación"
      data-menu-toggle
    >
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" id="primary-navigation" aria-label="Navegación principal" data-menu>
      <a href="#inicio">Inicio</a>
      <a href="#hamburguesa">La hamburguesa</a>
      <a href="#promociones">Promociones</a>
      <a href={burgerfit.instagram.url} target="_blank" rel="noreferrer">Instagram</a>
      <a class="nav-admin" href="/admin">Administración</a>
      <button class="button button--small button--yellow nav-order" type="button" data-order="unidad">
        Hacer mi pedido <span aria-hidden="true">↗</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (toggle && menu) {
    const closeMenu = () => {
      const wasOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú de navegación");
      menu.classList.remove("is-open");
      document.body.classList.remove("menu-open");
      if (wasOpen) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Abrir menú de navegación" : "Cerrar menú de navegación");
      menu.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("menu-open", !isOpen);
    });

    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>

---
import { burgerfit } from "../data/burgerfit";
---

<section class="instagram-section" id="instagram">
  <div class="container instagram-layout">
    <div class="instagram-copy">
      <p class="eyebrow eyebrow--dark">Pedidos y consultas</p>
      <h2>Encontranos <span>en Instagram.</span></h2>
      <p>Seguinos, consultá las promos y mandanos un mensaje para hacer tu pedido.</p>
      <a class="button button--black" href={burgerfit.instagram.url} target="_blank" rel="noreferrer">
        Seguinos en Instagram <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a
      class="instagram-badge"
      href={burgerfit.instagram.url}
      target="_blank"
      rel="noreferrer"
      aria-label={`Visitar Instagram ${burgerfit.instagram.handle}`}
    >
      <span class="instagram-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <defs>
            <linearGradient id="ig-gradient" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FFD21C" />
              <stop offset=".52" stop-color="#F04B4E" />
              <stop offset="1" stop-color="#9B3CF0" />
            </linearGradient>
          </defs>
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="url(#ig-gradient)" stroke-width="2" />
          <circle cx="12" cy="12" r="4" stroke="url(#ig-gradient)" stroke-width="2" />
          <circle cx="17.5" cy="6.8" r="1.2" fill="#F04B4E" />
        </svg>
      </span>
      <span class="instagram-handle">{burgerfit.instagram.handle}</span>
      <span class="instagram-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

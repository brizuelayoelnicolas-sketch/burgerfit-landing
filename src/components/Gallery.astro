---
import { burgerfit } from "../data/burgerfit";
---

<section class="gallery-section section-dark" id="galeria">
  <div class="container">
    <div class="section-heading gallery-heading">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Así se ve Burgerfit</p>
      <h2>El sabor también <span>se comparte.</span></h2>
    </div>
    <div class="gallery-grid">
      <a class="gallery-piece gallery-piece--wide" href={burgerfit.instagram.url} target="_blank" rel="noreferrer" aria-label="Ver Burgerfit en Instagram">
        <img
          src={burgerfit.images.sloganArtwork}
          alt="Arte de Burgerfit con el mensaje Sabor que te pone en forma"
          width="1254"
          height="1254"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a class="gallery-piece gallery-piece--square" href={burgerfit.instagram.url} target="_blank" rel="noreferrer" aria-label="Ver la cuenta de Instagram de Burgerfit">
        <img
          src={burgerfit.images.instagramLogo}
          alt="Logo de Burgerfit con el ícono de Instagram y el usuario b.urgerfit"
          width="1254"
          height="1254"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

---
import { burgerfit } from "../data/burgerfit";
---

<section class="promotions-section section-dark" id="promociones">
  <div class="container">
    <div class="section-heading promotions-heading">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Para compartir</p>
      <h2>Las promos <span>de Burgerfit.</span></h2>
      <p>Elegí tu combo y hacé el pedido desde acá.</p>
    </div>

    <div class="offer-list">
      {burgerfit.promotions.map((promotion, index) => (
        <article class:list={["offer", index === 1 && "offer--reverse"]}>
          <div class="offer-count">
            <span class="offer-number">{promotion.quantity}</span>
            <span class="offer-word">hamburguesas</span>
          </div>
          <div class="offer-meta">
            <span class="offer-label">Promo Burgerfit</span>
            <p class="offer-price">{promotion.price}</p>
            <button class="button button--yellow" type="button" data-order={`combo-${promotion.quantity}`}>
              Pedir {promotion.quantity} <span aria-hidden="true">↗</span>
            </button>
          </div>
          <span class="offer-spark offer-spark--a" aria-hidden="true">✳</span>
          <span class="offer-spark offer-spark--b" aria-hidden="true">✳</span>
        </article>
      ))}
    </div>
  </div>
</section>
